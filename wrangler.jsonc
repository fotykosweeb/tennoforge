{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tennoforge",
  "compatibility_date": "2026-09-01",
  "main": "worker.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*"]
  }
}
{
  "observability": {
    "logs": {
      "enabled": false,
      "invocation_logs": true
    }
  }
}
